---
import fs from 'node:fs';
import path from 'node:path';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/utils';

interface Props { titulo: string; bajada: string; poster: ImageMetadata }
const { titulo, bajada, poster } = Astro.props;

// El clip vive en public/video/. Si no existe, el hero muestra solo la foto.
const existe = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', 'video', f));
const fuentes = [
  existe('hero.webm') && { src: url('/video/hero.webm'), type: 'video/webm' },
  existe('hero.mp4') && { src: url('/video/hero.mp4'), type: 'video/mp4' },
].filter(Boolean) as { src: string; type: string }[];
const movil = existe('hero-movil.mp4') ? url('/video/hero-movil.mp4') : undefined;

const posterGrande = await getImage({ src: poster, width: 1920, format: 'webp', quality: 72 });
const posterMovil = await getImage({ src: poster, width: 900, format: 'webp', quality: 70 });
---
<section class="hero">
  <div class="media" aria-hidden="true">
    <picture>
      <source media="(max-width: 700px)" srcset={posterMovil.src} />
      <img src={posterGrande.src} alt="" width="1920" height={Math.round(1920 * poster.height / poster.width)} fetchpriority="high" />
    </picture>
    {fuentes.length > 0 && (
      <video
        muted
        loop
        playsinline
        preload="none"
        poster={posterGrande.src}
        data-hero-video
        data-sources={JSON.stringify(fuentes)}
        data-movil={movil}
      ></video>
    )}
  </div>
  <div class="wrap contenido">
    <span class="label">Estadio Bicentenario Municipal · La Florida</span>
    <h1>{titulo}</h1>
    <p>{bajada}</p>
    <div class="ctas">
      <a class="btn solido" href={url('/eventos/')}>Próximos eventos</a>
      <a class="btn" href={url('/visitanos/')}>Cómo llegar</a>
    </div>
  </div>
  <div class="franja" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: min(88svh, 860px); display: grid; align-items: end;
  }
  .media { position: absolute; inset: 0; z-index: -1; }
  .media img, .media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .media video { opacity: 0; transition: opacity .8s ease; }
  .media video.listo { opacity: 1; }
  .media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, var(--bg) 2%, rgba(10,18,14,.45) 50%, rgba(10,18,14,.55));
  }
  .contenido { width: 100%; display: grid; gap: 20px; padding-block: 140px 64px; }
  h1 {
    font-family: var(--display); font-weight: 900; text-transform: uppercase;
    font-size: clamp(3.4rem, 12vw, 10rem); line-height: .86; margin: 0; letter-spacing: .005em;
    max-width: 10ch;
  }
  p { margin: 0; max-width: 46ch; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: #dfe4da; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .franja { position: absolute; left: 0; right: 0; bottom: 0; }
</style>

<script>
  // Carga el clip solo después de que la página terminó de cargar,
  // y nunca con "ahorro de datos" o "reducir movimiento" activados.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (video && !reduce && !conn?.saveData) {
    const start = () => {
      const lista: { src: string; type: string }[] = JSON.parse(video.dataset.sources || '[]');
      const movil = video.dataset.movil;
      const fuentes = movil && matchMedia('(max-width: 700px)').matches ? [{ src: movil, type: 'video/mp4' }] : lista;
      for (const f of fuentes) {
        const s = document.createElement('source');
        s.src = f.src; s.type = f.type; video.appendChild(s);
      }
      video.load();
      video.addEventListener('playing', () => video.classList.add('listo'), { once: true });
      video.play().catch(() => {});
    };
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  }
</script>
