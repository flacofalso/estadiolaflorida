---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logo from '../assets/logo/logo-color-fondo-oscuro.png';

interface Props { titulo: string; fotos: ImageMetadata[] }
const { titulo, fotos } = Astro.props;
// Las fotos del recorrido se muestran pasando rápido: calidad media para que carguen livianas.
---
<section class="recorrido" aria-label={titulo} data-recorrido>
  <div class="escena">
    <div class="intro" data-intro>
      <h2>{titulo}</h2>
      <span class="label">Baja para ver las fotos</span>
    </div>

    {fotos.map((f, i) => (
      <div class:list={['foto', { vertical: f.height > f.width }]} data-foto data-i={i}>
        <Image src={f} alt="" width={900} quality={62} format="webp" loading="lazy" decoding="async" />
      </div>
    ))}

    <div class="logo-final" data-logo>
      <Image src={logo} alt="Estadio Bicentenario Municipal de La Florida" width={1000} quality={90} loading="lazy" />
    </div>

    <div class="pista" data-pista aria-hidden="true"><i></i>Scroll</div>
    <div class="medidor" aria-hidden="true"><b data-medidor></b></div>
  </div>
</section>

<style>
  .recorrido { position: relative; height: 620svh; }
  .escena {
    position: sticky; top: 0; height: 100svh; overflow: hidden;
    display: grid; place-items: center;
  }
  .escena::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(50% 50% at 50% 50%, rgba(138,166,66,.16), transparent 70%);
  }
  .intro { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 8px; text-align: center; padding-inline: var(--gutter); pointer-events: none; }
  h2 {
    font-family: var(--display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(2.4rem, 7vw, 5rem); line-height: .92; margin: 0;
  }
  .foto {
    position: absolute; left: 50%; top: 50%;
    width: clamp(160px, 27vw, 360px); aspect-ratio: 4 / 3; max-width: 100%;
    border-radius: 6px; overflow: hidden; opacity: 0;
    will-change: transform, opacity;
    box-shadow: 0 30px 60px rgba(0,0,0,.45);
  }
  .foto.vertical { aspect-ratio: 3 / 4; width: clamp(120px, 19vw, 250px); }
  .foto img { width: 100%; height: 100%; object-fit: cover; }
  .logo-final { position: absolute; width: min(78vw, 560px); opacity: 0; will-change: transform, opacity; padding-inline: var(--gutter); }
  .logo-final img { width: 100%; height: auto; }
  .pista {
    position: absolute; left: 50%; transform: translateX(-50%);
    bottom: calc(22px + env(safe-area-inset-bottom, 0px));
    display: flex; align-items: center; gap: 10px;
    font-family: var(--label); text-transform: uppercase; letter-spacing: .2em; font-size: .75rem; color: var(--muted);
  }
  .pista i { display: block; width: 1px; height: 28px; background: var(--muted); animation: caer 1.6s ease-in-out infinite; }
  @keyframes caer {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
  .medidor { position: absolute; right: var(--gutter); top: 50%; transform: translateY(-50%); height: 34svh; width: 2px; background: var(--line); }
  .medidor b { display: block; width: 100%; height: 0; background: linear-gradient(var(--amarillo), var(--terracota), var(--verde), var(--azul)); }

  /* Sin animación: grilla de fotos y el logo al final */
  @media (prefers-reduced-motion: reduce) {
    .recorrido { height: auto; }
    .escena {
      position: relative; height: auto; display: grid; gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      padding: 72px var(--gutter);
    }
    .intro { position: relative; grid-column: 1 / -1; padding-bottom: 16px; }
    .pista, .medidor { display: none; }
    .foto, .foto.vertical { position: relative; left: auto; top: auto; width: 100%; aspect-ratio: 4 / 3; opacity: 1; transform: none !important; }
    .logo-final { position: relative; grid-column: 1 / -1; justify-self: center; opacity: 1 !important; transform: none !important; margin-top: 40px; }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-recorrido]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (seccion && !reduce) {
    const fotos = [...seccion.querySelectorAll<HTMLElement>('[data-foto]')];
    const logo = seccion.querySelector<HTMLElement>('[data-logo]')!;
    const intro = seccion.querySelector<HTMLElement>('[data-intro]')!;
    const pista = seccion.querySelector<HTMLElement>('[data-pista]')!;
    const medidor = seccion.querySelector<HTMLElement>('[data-medidor]')!;

    // Cada foto sale desde el centro hacia un punto distinto del borde.
    const angulos = [-150, -30, 150, 30, -90, 90, -120, -60, 120, 60, -165, 15, 165, -15];
    const N = fotos.length;
    const DURA = 0.3;                                  // fracción del recorrido que dura cada foto
    const PASO = N > 1 ? (0.78 - DURA) / (N - 1) : 0;  // las fotos terminan antes del logo
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

    let pendiente = false;
    const pintar = () => {
      pendiente = false;
      const r = seccion.getBoundingClientRect();
      const total = seccion.offsetHeight - innerHeight;
      const g = clamp(-r.top / total, 0, 1);
      if (r.bottom < 0 || r.top > innerHeight) return;
      const ax = innerWidth * 0.5;
      const ay = innerHeight * 0.45;

      fotos.forEach((el, i) => {
        const inicio = 0.06 + i * PASO;
        const p = clamp((g - inicio) / DURA, 0, 1);
        const a = (angulos[i % angulos.length] * Math.PI) / 180;
        const d = ease(p);
        const x = Math.cos(a) * ax * (0.15 + d * 1.25);
        const y = Math.sin(a) * ay * (0.15 + d * 1.1);
        const s = 0.35 + d * 1.35;
        const o = p <= 0 || p >= 1 ? 0 : p < 0.18 ? p / 0.18 : p > 0.72 ? (1 - p) / 0.28 : 1;
        el.style.opacity = o.toFixed(3);
        el.style.zIndex = String(Math.round(p * 100));
        el.style.transform = `translate(-50%,-50%) translate(${x.toFixed(1)}px,${y.toFixed(1)}px) scale(${s.toFixed(3)})`;
      });

      const l = clamp((g - 0.8) / 0.14, 0, 1);
      logo.style.opacity = l.toFixed(3);
      logo.style.transform = `scale(${(0.8 + ease(l) * 0.2).toFixed(3)})`;
      intro.style.opacity = clamp(1 - g / 0.08, 0, 1).toFixed(3);
      pista.style.opacity = clamp(1 - g / 0.9, 0, 1).toFixed(3);
      medidor.style.height = `${(g * 100).toFixed(1)}%`;
    };
    const pedir = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); } };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    // Precarga las fotos un poco antes de llegar a la sección
    const io = new IntersectionObserver((e) => {
      if (e[0].isIntersecting) {
        seccion.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
        io.disconnect();
      }
    }, { rootMargin: '600px 0px' });
    io.observe(seccion);
    pintar();
  }
</script>
